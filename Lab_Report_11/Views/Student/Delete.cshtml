@model Lab_Report_11.Models.Student

<!DOCTYPE html>
<html>
<head>
    <title>Delete Student</title>
</head>

<body>

    <h1>Delete Student</h1>

    <h3>
        Are you sure you want to delete this student?
    </h3>

    <hr />

    <p>
        <strong>ID:</strong>
        @Model.Id
    </p>

    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Age:</strong>
        @Model.Age
    </p>

    <p>
        <strong>Phone:</strong>
        @Model.Phone
    </p>

    <p>
        <strong>Course:</strong>
        @Model.Course
    </p>

    <p>
        <strong>Batch:</strong>
        @Model.Batch
    </p>

    <p>
        <strong>Joined Year:</strong>
        @Model.JoinedYear
    </p>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit">
            Yes, Delete
        </button>

        <a asp-action="Index">
            Cancel
        </a>

    </form>

</body>
</html>