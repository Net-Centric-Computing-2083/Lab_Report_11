@model Lab_Report_11.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<h3>Are you sure you want to delete this student?</h3>

<div>

    <dl class="row">

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Age</dt>
        <dd class="col-sm-9">@Model.Age</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.Course</dd>

        <dt class="col-sm-3">Batch</dt>
        <dd class="col-sm-9">@Model.Batch</dd>

        <dt class="col-sm-3">Joined Year</dt>
        <dd class="col-sm-9">@Model.JoinedYear</dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>