@model Lab_Report_11.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>
<p>Are you sure you want to delete this student?</p>

<table border="1" cellpadding="8" cellspacing="0">
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Age</th><td>@Model.Age</td></tr>
    <tr><th>Phone</th><td>@Model.Phone</td></tr>
    <tr><th>Course</th><td>@Model.Course</td></tr>
    <tr><th>Batch</th><td>@Model.Batch</td></tr>
    <tr><th>Joined Year</th><td>@Model.JoinedYear</td></tr>
</table>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
</form>