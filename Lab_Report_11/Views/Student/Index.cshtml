@model IEnumerable<Lab_Report_11.Models.Student>

<h2>Student List</h2>
<p>
    <a asp-action="Create">Add New Student</a>
</p>
<table border="1" cellpadding="8">
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Phone</th>
        <th>Course</th>
        <th>Batch</th>
        <th>Joined Year</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.Phone</td>
            <td>@item.Course</td>
            <td>@item.Batch</td>
            <td>@item.JoinedYear</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>